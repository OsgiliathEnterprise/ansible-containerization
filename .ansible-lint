exclude_paths:
 - .cache/
 - .poetry/
 - .ansible/
 - .tox/
 - meta/
 - molecule/
 - .tox/
skip_list:
 - '106'  # Role name {} does not match ``^[a-z][a-z0-9_]+$`` pattern
 - var-naming[no-role-prefix]  # Variable names should not contain role name
 - galaxy[no-changelog]  # Role does not have a valid CHANGELOG.md file
